{
  "name": "@t3tools/cartographer-core",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first repository graph and architecture analysis engine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./snapshots": {
      "types": "./src/snapshots/store.ts",
      "import": "./dist/snapshots/store.js"
    },
    "./analysis-worker": {
      "types": "./src/snapshots/worker.ts",
      "import": "./dist/snapshots/worker.js"
    }
  },
  "scripts": {
    "build": "node scripts/cleanDist.mjs && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "dependency-cruiser": "18.2.0",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
