{
  "name": "@t3tools/cartographer-core",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first repository graph and architecture analysis engine.",
  "license": "MIT",
  "bin": {
    "cartographer": "./dist/cli/index.js",
    "cartographer-mcp": "./dist/mcp/bin.js"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "node scripts/cleanDist.mjs && node node_modules/typescript-7/bin/tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dependency-cruiser": "^18.0.0",
    "typescript": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "^10.4.1",
    "typescript-7": "npm:typescript@7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
