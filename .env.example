# Optional: externally supplied cloud/relay client configuration
# Configure these only when an independently operated service supplies the values.
# This repository and its release workflow do not deploy an external relay.
# Leave them unset to disable optional relay features in local source builds, and
# do not add server-side secrets to this file.

# Get these from the Clerk Dashboard under API keys and JWT templates.
# The mobile app consumes them through the EXPO_PUBLIC_CLERK_* projections.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# T3CODE_CLERK_JWT_TEMPLATE=456code-relay

# Get this from the operator of the external relay service you use.
# T3CODE_RELAY_URL=https://relay.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=456code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
