{
  "mcpServers": {
    "xcodebuildmcp": {
      "command": "npx",
      "args": ["--yes", "xcodebuildmcp@2.6.2", "mcp"],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,debugging,logging"
      }
    },
    "cartographer": {
      "command": "node",
      "args": ["packages/cartographer-core/dist/mcp/bin.js"]
    }
  }
}
